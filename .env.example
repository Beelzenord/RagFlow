# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# disable | prefer | require. Local compose Postgres has no TLS; Azure
# Flexible Server requires it — set POSTGRES_SSL=require there.
POSTGRES_SSL=prefer

# ─── Redis (n8n queue mode + future job queue) ───────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── n8n ─────────────────────────────────────────────────────────────────────
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Generate locally: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me-use-openssl-rand-hex-32
GENERIC_TIMEZONE=Europe/Stockholm
# Set to "queue" once you scale beyond a single n8n instance
EXECUTIONS_MODE=regular

# ─── LlamaParse / LlamaCloud ─────────────────────────────────────────────────
# Get a fresh key at https://cloud.llamaindex.ai (rotate any key shared in chat!)
LLAMA_CLOUD_API_KEY=

# ─── LLM + embedding provider ────────────────────────────────────────────────
# Provider: "openai" or "anthropic" (LLM only; embeddings always via OpenAI-compatible)
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1

EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1

# ─── Ingestion service ───────────────────────────────────────────────────────
INGESTION_PORT=8001
STORAGE_DIR=/data/storage
MAX_UPLOAD_MB=50
ALLOWED_MIME_TYPES=application/pdf,image/jpeg,image/jpg,image/png
CHUNK_SIZE=512
CHUNK_OVERLAP=64

# ─── Query service ───────────────────────────────────────────────────────────
QUERY_PORT=8002
# Hybrid retrieval: each of the vector and lexical retrievers returns
# RETRIEVAL_POOL_SIZE candidates, fused by Reciprocal Rank Fusion and cut to
# RETRIEVAL_TOP_K. RETRIEVAL_MIN_SCORE gates the vector side only.
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.25
RETRIEVAL_POOL_SIZE=30
RETRIEVAL_RRF_K=60
# Lexical search ignores terms appearing in more than this share of all chunks;
# it exists to find identifiers, not to repeat what vector search already does.
RETRIEVAL_LEXICAL_MAX_DF=0.02

# ─── Internal service auth (n8n → FastAPI) ───────────────────────────────────
SERVICE_API_KEY=change-me-to-a-shared-secret

# ─── Web UI ──────────────────────────────────────────────────────────────────
WEB_PORT=8080

# ─── Console login ───────────────────────────────────────────────────────────
# password | entra. Leave this at "password" locally: entra means "Container Apps
# authentication already signed the user in and named them in a request header",
# which is only true behind Azure Easy Auth. Nothing strips that header here.
AUTH_MODE=password
# One shared account. An empty ADMIN_PASSWORD leaves the console open to anyone
# who can reach the port — fine locally, never on a public URL.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the session cookie: openssl rand -hex 32. Left empty, a random secret is
# generated per process, so every restart signs everyone out.
SESSION_SECRET=
# Set to 1 when serving over HTTPS so the cookie is not sent in the clear.
SESSION_COOKIE_SECURE=

# ─── Who may upload and delete ───────────────────────────────────────────────
# Entra app roles on the app registration Easy Auth uses. Anyone holding the
# admin role may upload and delete; everyone else can only ask questions, which
# is also what an unassigned account gets. Only override these if the roles were
# named something else in Entra.
ENTRA_ADMIN_ROLE=Admin
ENTRA_READER_ROLE=Reader
# LOCAL ONLY: admin | reader, pinning every request to that role so one account
# can check both views without a second login. Ignored when AUTH_MODE=entra, so
# it cannot weaken the Azure deployment; leave it empty everywhere else, since
# "reader" locks the console's own admin out of uploading.
DEV_FORCE_ROLE=

# ─── Voice (ElevenLabs) ──────────────────────────────────────────────────────
# Leave ELEVENLABS_API_KEY empty to disable Voice mode; the mic button is then
# hidden rather than offered and refused.
ELEVENLABS_API_KEY=
# Per-language voice ids. The UI passes lang=en|sv and the BFF maps to the right voice.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_ID_SV=kPdGSxhZAqy4bmPAf9iJ
# Must be a *_v2_5 model. eleven_multilingual_v2 ignores language_code and infers
# the language from the text, which is how a Swedish answer gets English vowels.
# Flash is also the lower-latency option, which matters when speaking.
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_STT_MODEL=scribe_v1
