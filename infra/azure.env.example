# Copy to infra/azure.env and fill in. azure.env is gitignored.
#   cp infra/azure.env.example infra/azure.env

# Sweden Central; set LOCATION=westeurope if a SKU is missing there.
LOCATION=swedencentral
RESOURCE_GROUP=rg-ragflow
PREFIX=ragflow

# Globally unique. Leave blank to derive from PREFIX + a short hash.
# ACR: letters and numbers only. Storage account: 3-24 lowercase alphanumeric.
ACR_NAME=
POSTGRES_SERVER=
STORAGE_ACCOUNT=

ACA_ENV=
FILE_SHARE=rag-storage
# Name of the Azure Files mount registered on the Container Apps environment.
ACA_STORAGE_NAME=ragfiles

# Flexible Server rejects the username "postgres". Do not reuse local defaults.
POSTGRES_USER=ragadmin
# Quote the value if it contains #, spaces, or $ — azure.env is sourced as a shell file.
POSTGRES_PASSWORD=
POSTGRES_DB=rag

# New keys — not the ones in your laptop .env.
# LLM_API_KEY and EMBEDDING_API_KEY may be the same OpenAI secret.
LLM_API_KEY=
EMBEDDING_API_KEY=
LLAMA_CLOUD_API_KEY=
# openssl rand -hex 32
SERVICE_API_KEY=
