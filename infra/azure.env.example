# Copy to infra/azure.env and fill in. azure.env is gitignored.
#   cp infra/azure.env.example infra/azure.env

# Sweden Central; set LOCATION=westeurope if a SKU is missing there.
LOCATION=swedencentral
RESOURCE_GROUP=rg-ragflow
PREFIX=ragflow

# Globally unique. Leave blank to derive from PREFIX + a short hash.
# ACR: letters and numbers only. Storage account: 3-24 lowercase alphanumeric.
ACR_NAME=
POSTGRES_SERVER=
STORAGE_ACCOUNT=

ACA_ENV=
FILE_SHARE=rag-storage
# Name of the Azure Files mount registered on the Container Apps environment.
ACA_STORAGE_NAME=ragfiles

# Flexible Server rejects the username "postgres". Do not reuse local defaults.
POSTGRES_USER=ragadmin
# Quote the value if it contains #, spaces, or $ — azure.env is sourced as a shell file.
POSTGRES_PASSWORD=
POSTGRES_DB=rag

# New keys — not the ones in your laptop .env.
# LLM_API_KEY and EMBEDDING_API_KEY may be the same OpenAI secret.
LLM_API_KEY=
EMBEDDING_API_KEY=
LLAMA_CLOUD_API_KEY=
# openssl rand -hex 32
SERVICE_API_KEY=

# Console login.
#   entra    - Microsoft sign-in via Container Apps authentication. Enable it on
#              the web app first (portal: Authentication > Add identity provider
#              > Microsoft), require assignment on the enterprise app, and assign
#              your access group. deploy.sh refuses to ship without it enabled.
#   password - the app's own shared login; fill in the two values below.
AUTH_MODE=entra

# Who may upload and delete. These are Entra app roles on the app registration
# Easy Auth uses: assign the admin group to Admin and everyone else to Reader.
# Leave both blank unless the roles were named something else in Entra — the app
# defaults to Admin and Reader, and an account holding neither can only read.
ENTRA_ADMIN_ROLE=
ENTRA_READER_ROLE=

# Only used when AUTH_MODE=password. Quote the password if it contains #, spaces or $.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# openssl rand -hex 32. Shared by both web replicas, so it cannot be blank.
SESSION_SECRET=

# Keep one web replica warm on weekdays, so the first visit of the day is not a
# ~15 s cold start (Stockholm time; cron fields: minute hour day month weekday).
# Outside the window the web app scales to zero and the first request after a
# quiet spell waits for a container again. Roughly $4-5/month at the default
# 0.5 vCPU / 1 GiB. Set WEB_WARM_START= (empty) to switch the window off.
# Quoted because this file is sourced as shell and the values contain spaces.
WEB_WARM_TIMEZONE="Europe/Stockholm"
WEB_WARM_START="0 6 * * 1-5"
WEB_WARM_END="0 19 * * 1-5"

# Re-ranking (see the main README). llm by default; set to none to turn it off.
# RERANK_PROVIDER=llm
